# ─── Required: Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@nexora.co.uk
RESEND_NOTIFY_EMAIL=hello@nexora.co.uk

# ─── Optional: Contact form rate limiting ─────────────────────────────────────
# Maximum submissions per IP per 10-minute window (default: 3)
CONTACT_RATE_LIMIT_MAX=3

# ─── Required: Analytics (PostHog) ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Required: Site URL ───────────────────────────────────────────────────────
# Used in sitemap.ts, metadata canonical URLs, and email copy
NEXT_PUBLIC_SITE_URL=https://nexora.co.uk

# ─── Required: Supabase (contact form persistence) ───────────────────────────
# Project URL from Settings → API in the Supabase dashboard
SUPABASE_URL=
# Service-role secret key (bypasses RLS — keep server-side only, never expose)
SUPABASE_SERVICE_KEY=

# ─── Required: Upstash Redis (rate limiting) ─────────────────────────────────
# From console.upstash.com → your database → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Phase 2: Sanity CMS ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=

# ─── Phase 2: Resend webhooks ────────────────────────────────────────────────
# RESEND_WEBHOOK_SECRET=
